{{!
    @template block_recommended_courses/main
    Main template for the Recommended Courses block.

    Example context (json):
    {
        "uniqid": "test1",
        "hascourses": true,
        "courses": [
            {
                "id": 1,
                "fullname": "Course 1",
                "courseimage": "https://via.placeholder.com/150",
                "viewurl": "#",
                "enrollurl": "#",
                "summary": "Description",
                "first": true,
                "visible": true,
                "category": "Category 1",
                "has_contact": true,
                "contact_name": "Teacher 1",
                "contact_profileurl": "#",
                "lastmodified": "01.01.2025"
            }
        ],
        "buttontext": "Enrol now",
        "no_courses_message": "No courses",
        "prev_course": "Prev",
        "next_course": "Next",
        "layout_mode": "vertical",
        "image_fit": "cover",
        "image_height": "200",
        "border_radius": "8",
        "animation_speed": 300,
        "autoslide": 0,
        "show_button": true,
        "show_cards": true,
        "show_category": true,
        "show_contact": true,
        "show_lastmodified": true,
        "meta_label_category": "Semester / Area:",
        "meta_label_contact": "Responsible:",
        "meta_label_lastmodified": "Start:",
        "coursescount": 1,
        "current_position": 1,
        "show_enrolment_filter": true,
        "unenrolled_only": true,
        "enrolment_filter_label": "Show only courses I am not enrolled in",
        "enrolment_filter_pref": "block_recommended_courses_unenrolledonly",
        "coursesJson": "[]"
    }
}}
<div class="block_recommended_courses" id="block_recommended_courses_{{uniqid}}" data-image-fit="{{image_fit}}" data-image-height="{{image_height}}" data-border-radius="{{border_radius}}" data-animation-speed="{{animation_speed}}">
    {{#show_enrolment_filter}}
    <div class="enrolment-filter" data-preference="{{enrolment_filter_pref}}">
        <label class="enrolment-filter-control" for="enrolment-filter-{{uniqid}}">
            <span class="enrolment-filter-label">{{enrolment_filter_label}}</span>
            <span class="enrolment-filter-switch">
                <input id="enrolment-filter-{{uniqid}}"
                       class="enrolment-filter-input"
                       type="checkbox"
                       role="switch"
                       {{#unenrolled_only}}checked{{/unenrolled_only}}
                       aria-checked="{{#unenrolled_only}}true{{/unenrolled_only}}{{^unenrolled_only}}false{{/unenrolled_only}}">
                <span class="enrolment-filter-slider" aria-hidden="true"></span>
            </span>
        </label>
    </div>
    {{/show_enrolment_filter}}
    {{#hascourses}}
        <div class="slider-container">
            {{#courses}}
                {{#first}}
                    <div class="main-course-wrapper layout-{{layout_mode}}" data-course-id="{{id}}">
                        <div class="main-course" style="border-radius: {{border_radius}}px;">
                            <div class="main-course-image image-fit-{{image_fit}}" style="height: {{image_height}}px;">
                                <img src="{{courseimage}}" alt="{{fullname}}" style="object-fit: {{image_fit}};">
                            </div>
                            <div class="main-course-content">
                                <h2 class="main-course-title">
                                    <a href="{{viewurl}}" class="course-title-link">{{fullname}}</a>
                                </h2>
                                
                                <!-- Course meta information -->
                                <div class="course-meta-info">
                                    {{#show_category}}
                                    {{#category}}
                                    <div class="meta-field">
                                        <div class="meta-label">{{meta_label_category}}</div>
                                        <div class="meta-item meta-category">
                                            <i class="fa fa-folder-open" aria-hidden="true"></i>
                                            <span>{{category}}</span>
                                        </div>
                                    </div>
                                    {{/category}}
                                    {{/show_category}}

                                    {{#show_contact}}
                                    {{#has_contact}}
                                    <div class="meta-field">
                                        <div class="meta-label">{{meta_label_contact}}</div>
                                        <div class="meta-item meta-contact">
                                            <i class="fa fa-user" aria-hidden="true"></i>
                                            <a href="{{contact_profileurl}}" class="contact-name">{{contact_name}}</a>
                                        </div>
                                    </div>
                                    {{/has_contact}}
                                    {{/show_contact}}

                                    {{#show_lastmodified}}
                                    {{#lastmodified}}
                                    <div class="meta-field">
                                        <div class="meta-label">{{meta_label_lastmodified}}</div>
                                        <div class="meta-item meta-lastmodified">
                                            <i class="fa fa-calendar" aria-hidden="true"></i>
                                            <span>{{lastmodified}}</span>
                                        </div>
                                    </div>
                                    {{/lastmodified}}
                                    {{/show_lastmodified}}
                                </div>
                                
                                <div class="main-course-description">{{summary}}</div>
                                {{#show_button}}
                                <div class="button-container">
                                    <a href="{{enrollurl}}" class="btn btn-primary course-action-btn">{{actiontext}}</a>
                                </div>
                                {{/show_button}}
                            </div>
                        </div>
                    </div>
                {{/first}}
            {{/courses}}
            
            <div class="slider-progress">
                <div class="slider-counter" aria-live="polite">{{current_position}} / {{coursescount}}</div>
                <div class="slider-nav-row">
                    <div class="slider-nav prev" role="button" tabindex="0" aria-label="{{prev_course}}" title="{{prev_course}}">
                        <i class="fa fa-chevron-left" aria-hidden="true"></i>
                    </div>
                    <div class="slider-indicators"></div>
                    <div class="slider-nav next" role="button" tabindex="0" aria-label="{{next_course}}" title="{{next_course}}">
                        <i class="fa fa-chevron-right" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
            
            {{#show_cards}}
            <div class="course-cards">
                {{#courses}}
                    {{^first}}
                        {{#visible}}
                            <div class="course-card" data-course-id="{{id}}" role="button" tabindex="0" aria-label="{{fullname}}">
                                <div class="course-card-image">
                                    <img src="{{courseimage}}" alt="{{fullname}}">
                                </div>
                                <div class="course-card-title">{{fullname}}</div>
                            </div>
                        {{/visible}}
                    {{/first}}
                {{/courses}}
            </div>
            {{/show_cards}}
        </div>
    {{/hascourses}}
    
    {{^hascourses}}
        <div class="no-courses">{{no_courses_message}}</div>
    {{/hascourses}}
</div>

{{#js}}
require(['block_recommended_courses/slider', 'block_recommended_courses/enrolment_filter'], function(slider, enrolmentFilter) {
    slider.init(
        'block_recommended_courses_{{uniqid}}',
        {{{coursesJson}}},
        {
            layoutMode: '{{layout_mode}}',
            imageFit: '{{image_fit}}',
            imageHeight: '{{image_height}}',
            borderRadius: '{{border_radius}}',
            animationSpeed: {{animation_speed}},
            autoslide: {{autoslide}},
            showButton: {{show_button}},
            showCards: {{show_cards}},
            showCategory: {{show_category}},
            showContact: {{show_contact}},
            showLastmodified: {{show_lastmodified}},
            metaLabelCategory: {{{meta_label_category_json}}},
            metaLabelContact: {{{meta_label_contact_json}}},
            metaLabelLastmodified: {{{meta_label_lastmodified_json}}}
        }
    );
    enrolmentFilter.init('block_recommended_courses_{{uniqid}}');
});
{{/js}}
